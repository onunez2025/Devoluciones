# OneDrive API (Microsoft Graph)
# Se recomienda usar App Registration en Azure
ONEDRIVE_CLIENT_ID=tu_client_id
ONEDRIVE_CLIENT_SECRET=tu_client_secret
ONEDRIVE_TENANT_ID=tu_tenant_id
ONEDRIVE_FOLDER_ID=id_de_la_carpeta_devoluciones

# ─── SMTP (envío de correo, respaldo si no hay Microsoft Graph) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM=

# ─── Microsoft Graph (envío de correo — distinto de ONEDRIVE_* de arriba) ───
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=

# ─── Casdoor SSO (login social Google/Microsoft) ─────────────────────────────
CASDOOR_ENDPOINT=https://auth.siatc.cloud
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_REDIRECT_URI=https://devoluciones.siatc.cloud/api/auth/sso/callback
FRONTEND_URL=https://devoluciones.siatc.cloud

# Fase 20: dominio de la cookie SSO compartida. Sin definir = .siatc.cloud (comportamiento
# actual de producción). En QA, configurar como .qa.siatc.cloud para activar el SSO real
# entre las 10 apps QA sin afectar producción. VITE_COOKIE_DOMAIN es la misma variable
# pero inyectada en build-time del frontend (Vite) -- deben coincidir.
COOKIE_DOMAIN=
VITE_COOKIE_DOMAIN=

# ─── Redis (aislar contadores de rate-limit/blacklist entre prod y QA) ───────
REDIS_DB=0
